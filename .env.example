# =========================================================
# 豆苗时光机 · 后端配置示例
# 复制本文件并重命名为 .env，再按需要填写。
# .env 只放在你自己的电脑上，不要发给别人、不要上传网盘。
# =========================================================

# 阿里云百炼（DashScope）API Key；不填也能玩，AI 对话会走本地兜底应答
DASHSCOPE_API_KEY=

# 对话模型：qwen-flash 最快；qwen-plus 更稳但稍慢
CHAT_MODEL=qwen-flash

# 服务端口；被占用时改成 3003、3005 都可以
PORT=3002
